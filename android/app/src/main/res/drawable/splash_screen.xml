<?xml version="1.0" encoding="utf-8"?>
<!--
  Native splash screen drawable — shown by the OS before any JS/React loads.
  Uses a layer-list so we get a solid brand-blue background with the launcher
  foreground icon centred on top. This works back to API 24 (minSdk).

  The background colour (#1C32FF) is the same as ic_launcher_background, so the
  transition from splash → app icon on the launcher shelf is seamless.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Brand blue background, matches ic_launcher_background -->
    <item android:drawable="@color/ic_launcher_background" />

    <!-- Tally logo centred: scaled to 25% of screen width on each side (effectively 50% of
         total screen width), vertically centred with the same inset. This gives the same
         proportions as the icon on the home screen without clipping. -->
    <item
        android:gravity="center"
        android:width="120dp"
        android:height="120dp">
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground"
            android:tileMode="disabled" />
    </item>
</layer-list>
